{
  "compilerOptions": {
	    "target": "esnext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"noEmit": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"inlineSources": true,
		"isolatedModules": true,
		"rootDir": ".",
		"allowUnusedLabels": false,
		"removeComments": false,
		"resolveJsonModule": true,
		"useDefineForClassFields": true,
		"noErrorTruncation": true,
		"types": ["jest", "jquery", "node", "fvtt-types", "gurps/src/types/gurps"],
        "paths": {
            "@gurps-types/*": ["./node_modules/gurps/src/types/*"],
            "@lib/*": ["./node_modules/gurps//src/lib/*"],
            "@module/*": ["./node_modules/gurps/src/module/*"],
            "@rules/*": ["./node_modules/gurps/src/rules/*"],
            "@util/*": ["./node_modules/gurps/src/util/*"]
        }
        //"typeRoots": ["node_modules/@types", "types/foundry","jest"],
  },
  //"include": ["src"]
}
