{{#*inline ".locationEntry"}}
    <div class='where'>{{where}}</div>
    <div class='penalty gga-right  {{ifThen (gte penalty 0) 'gcs-mod-positive' 'gcs-mod-negative' }}' 
         data-action='addModifier' data-value='{{penalty}}' 
         data-comment='{{localize 'GURPS.hitLocationPenalty'}}: {{where}}'>
        {{penalty}}
    </div>
{{/inline}}

{{#if (notEmpty targets)}}
    {{#each targets}}
        <div class="slcs-target">
            <div class="name">Target: {{name}}</div>
            {{#if (notEmpty targetmodifiers)}}
                <div class="slcs-block slcs-otflist">
                    {{#each targetmodifiers}}
                        {{{mod}}}
                    {{/each}}
                </div>
            {{/if}}
            <div class="slcs-location slcs-block gga-table">
                {{#each hitlocations}}
                    {{> ".locationEntry"}}
                {{else}}
                    {{#each ../system.hitlocationsV2}}
                        {{> ".locationEntry"}}
                    {{/each}}
                {{/each}}
            </div>
        </div>
    {{/each}}
{{else}}
    <div class="slcs-target">
        <div class="slcs-location slcs-block gga-table">
            {{#each system.hitlocationsV2}}
                {{> ".locationEntry"}}
            {{/each}}
        </div>
    </div>
{{/if}}
