{{#if (notEmpty meleeWeapons)}}
    <div class='slcs-melee-attacks slcs-item-table with-notes slcs-block'>
        <div class='weapon header'>{{localize  'GURPS.sheet.gcsActorSheet.weaponMelee'}}</div>
        <div class='usage header'>{{localize  'GURPS.sheet.gcsActorSheet.weaponUsage'}}</div>
        <div class='level header'>{{localize  'GURPS.sheet.gcsActorSheet.skillLevel'}}</div>
        <div class='damage header'>{{localize  'GURPS.sheet.gcsActorSheet.weaponDamage'}}</div>
        <div class='reach header'>{{localize  'GURPS.sheet.gcsActorSheet.weaponReach'}}</div>

        {{#stripesouter meleeWeapons 'evenOuter' 'oddOuter' 'meleeList' }}
            {{#stripes meleeList 'even' 'odd'}}

                {{#if @first}}
                    <div class='weapon {{stripeClass}} {{stripeClass}} {{../stripeClass}}{{#if selected}} selected{{/if}}{{#if @last}} last{{/if}}' data-item-id='{{../id}}' data-uuid='{{../uuid}}'> 
                        <div class='desc'>
                            <div class='equipment-name'>{{../name}}</div>
                            {{#if ../hasNotes}}
                                <i class='fa-solid {{ifThen ../notesOpen 'fa-book-open' 'fa-book'}} gcs-notes-toggle' data-action='toggleNotes' data-open='{{../notesOpen}}'></i>
                            {{/if}}
                        </div>
                    </div>
                {{else}}
                    <div class='weapon empty {{stripeClass}} {{../stripeClass}}{{#if selected}} selected{{/if}}{{#if @last}} last{{/if}}'></div>
                {{/if}}

                <div class='usage {{stripeClass}} {{../stripeClass}}{{#if selected}} selected{{/if}}' data-uuid='{{uuid}}' data-action='rollOtf' data-value='{{otf.level}}'>
                    <div class='desc'>
                        <div class='usage-name'>{{usage}}</div>
                        {{#if hasNotes}}
                            <i class='fa-solid {{ifThen notesOpen 'fa-book-open' 'fa-book'}} gcs-notes-toggle' data-action='toggleNotes' data-open='{{notesOpen}}'></i>
                        {{/if}}
                    </div>
                    {{#if (and hasNotes notesOpen)}}
                        <div class="usage-notes gcs-item-notes ">{{notes}}</div>
                    {{/if}}
                </div>

                <div class='level {{stripeClass}}  {{../stripeClass}}{{#if selected}} selected{{/if}}'  data-uuid='{{uuid}}' data-action='rollOtf' data-value='{{otf.level}}'>{{level}}</div>
                <div class='slcs-damage {{stripeClass}}  {{../stripeClass}}{{#if selected}} selected{{/if}}'  data-uuid='{{uuid}}' data-action='rollOtf' data-value='{{otf.damage}}'>{{damage}}</div>
                <div class='reach {{stripeClass}}  {{../stripeClass}}{{#if selected}} selected{{/if}}'>{{reach}}</div>
            {{/stripes}}
            {{#if (and hasNotes notesOpen)}}
                <div class='list_note'>{{notes}}</div>
            {{/if}}
        {{/stripesouter}}
    </div>
    {{>slcs-otf-region OTFs=meleeOTFs type='melee'}}
{{/if}}
