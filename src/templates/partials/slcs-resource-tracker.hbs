{{#*inline ".poolTooltip"}}
  <div class="gcs-tooltip gcs-pool-tooltip">
    {{#each pool.thresholds}}
    <div class="threshold">
      <span class="value">{{value}}</span>
      <span class="condition">{{localize state}}</span>
    </div>
    {{/each}}
  </div>
{{/inline}}

<div class="gcs-pool-attribute gcs-section"">
  <div class="gcs-section-header">
    {{localize pool.name}}{{#if (eq pool.type "pool")}}: {{pool.denominator.value}}{{/if}}
  </div>
  <div class="gcs-section-content">
    <div class="form-fields slcs-pool-control">
      <button type="button" data-action="decrementPool" data-inverted="{{pool.invertedDelta}}" data-path="{{pool.numerator.path}}" {{#if pool.atMin}}disabled{{/if}}><i class="fa-solid fa-minus"></i></button>
      {{#if (eq pool.type "pool")}}
        <pool-value name="{{pool.numerator.path}}" value="{{pool.numerator.value}}" data-max="{{pool.denominator.value}}"></pool-value>
      {{else}}
        {{#if pool.numerator.name}}
          {{formInput pool.numerator.field name=pool.numerator.name value=pool.numerator.value }}
        {{else}}
          {{formInput pool.numerator.field value=pool.numerator.value }}
        {{/if}}
      {{/if}}
      <button type="button" data-action="incrementPool" data-inverted="{{pool.invertedDelta}}" data-path="{{pool.numerator.path}}" {{#if pool.atMax}}disabled{{/if}}><i class="fa-solid fa-plus"></i></button>
      <button type="button" data-action="resetPool" data-inverted="{{pool.invertedDelta}}" data-initial="{{pool.numerator.initial}}" data-path="{{pool.numerator.path}}"><i class="fa-solid fa-undo"></i></button>
    </div>
    {{#if (or pool.state pool.color pool.thresholds.length)}}
      <div
        class="pool-state"
        data-tooltip='{{> '.poolTooltip' thresholds=pool.thresholds}}'
        style="background-color: {{pool.color}}; color: var(--gcs-color-surface-fg);"
      >{{localize pool.state}}</div>
    {{/if}}
  </div>
</div>