
{{#*inline ".traitEntry"}}
    <div class='gcs-item-row {{stripeClass}} indent{{indent}}' data-item-id='{{id}}' data-uuid='{{uuid}}' data-has-children='{{hasChildren}}' draggable='true'> 
        <div class='desc dblclkedit'>
            {{#if hasChildren}}
                <i class='fa-solid fa-caret-down gcs-container-toggle' data-open='{{childrenOpen}}' data-action='toggleContainer'></i>
            {{else}}
                <span class='gcs-container-spacer'></span>
            {{/if}}
            <div class='trait-name'>{{fullName}}</div>
            {{#if hasNotes}}
                <i class='fa-solid {{ifThen notesOpen 'fa-book-open' 'fa-book'}} gcs-notes-toggle' data-action='toggleNotes' data-open='{{notesOpen}}'></i>
            {{/if}}
        </div>
    </div>
    <div class='ref flex-center {{stripeClass}}'>{{{pdflinkext this}}} </div>
    {{#if otf.cr}}
        <div class='slcs-control-roll indent{{indent}}'> {{gurpslink otf.cr}}</div>
    {{/if}}
    {{#if (and hasNotes notesOpen)}}
        <div class='list_note indent{{indent}} {{stripeClass}}'>{{notes}}</div>
    {{/if}}
{{/inline}}

{{#if (notEmpty traits)}}
    <div class='slcs-traits slcs-item-table with-notes slcs-block'>
        {{#stripesrecursive traits 'even' 'odd' }}
            {{> ".traitEntry"}}
        {{/stripesrecursive}}
    </div>
{{/if}}